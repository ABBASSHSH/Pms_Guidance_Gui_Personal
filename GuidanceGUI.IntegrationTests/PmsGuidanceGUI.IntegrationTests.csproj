<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GuidanceHost.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test host & runner -->
    <PackageReference Include="Microsoft.NET.Test.Sdk"           Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter"               Version="3.10.2"  />
    <PackageReference Include="MSTest.TestFramework"             Version="3.10.2"  />

    <!-- BDD framework -->
    <PackageReference Include="Reqnroll.MSTest"                  Version="3.2.0"   />

    <!-- Playwright for CDP-based browser automation -->
    <PackageReference Include="Microsoft.Playwright.MSTest"      Version="1.57.0"  />
    <PackageReference Include="Microsoft.Playwright.TestAdapter" Version="1.57.0"  />

    <!-- Code coverage -->
    <PackageReference Include="coverlet.collector"               Version="6.0.4"   />
    <PackageReference Include="coverlet.msbuild"                 Version="6.0.4"   />
  </ItemGroup>

  <!-- Copy .feature files to output so Reqnroll can find them at runtime -->
  <ItemGroup>
    <None Update="Features\**\*.feature">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
