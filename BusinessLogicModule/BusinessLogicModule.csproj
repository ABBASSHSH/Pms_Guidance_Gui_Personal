<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\LoggingModule\LoggingModule.csproj" />
  </ItemGroup>

  <ItemGroup>
        <!-- Expose internals to the unit-test project so tests can directly instantiate
          internal command handlers with mock IConfigurationProvider. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Pms_GuidanceGUI.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Required by Moq to generate dynamic proxies for internal interfaces. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
