<?xml version="1.0" encoding="utf-8"?>
<!--
  Local nuget.config for the test project only.
  The SHUIHTML5 private feed requires authentication that is not available
  in all environments. The test project only needs MSTest packages from nuget.org,
  so the private feed is disabled here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Microsoft Visual Studio Offline Packages"
         value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
